# ============================================
# Configuration de la Base de Données
# ============================================
# Pour hébergement gratuit, utilisez Supabase ou Neon
# Voir HEBERGEMENT_DB_GRATUIT.md pour les instructions

# Configuration locale (Docker)
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=retro_user
# DATABASE_PASSWORD=retro_password
# DATABASE_NAME=retro_collection

# Configuration Supabase (Recommandé)
# Récupérer ces valeurs depuis: Settings > Database > Connection string
DATABASE_HOST=db.xxxxx.supabase.co
DATABASE_PORT=5432
# Pour connection pooling (recommandé en production), utilisez le port 6543
# DATABASE_PORT=6543
DATABASE_USER=postgres
DATABASE_PASSWORD=votre_mot_de_passe_ici
DATABASE_NAME=postgres

# Configuration Neon (Alternative)
# DATABASE_HOST=ep-xxxxx-xxxxx.us-east-2.aws.neon.tech
# DATABASE_PORT=5432
# DATABASE_USER=neondb_owner
# DATABASE_PASSWORD=votre_mot_de_passe_ici
# DATABASE_NAME=neondb

# ============================================
# Configuration de l'Application
# ============================================
NODE_ENV=production
PORT=9876

# ============================================
# Configuration API
# ============================================
VERSION=1.0.0
NAME=Retro Collection API
PRODUCT=retro
SIDE=api
VERSION_SHORT=1

# ============================================
# Sécurité - JWT
# ============================================
# IMPORTANT: Générez des secrets forts et aléatoires pour la production!
# Vous pouvez générer avec: openssl rand -base64 32
JWT_SECRET=votre_secret_jwt_tres_long_et_aleatoire_ici
JWT_REFRESH_SECRET=votre_refresh_secret_jwt_tres_long_et_aleatoire_ici



